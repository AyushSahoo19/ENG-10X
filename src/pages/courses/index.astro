---
import PhaseLayout from '../../layouts/PhaseLayout.astro';
---

<PhaseLayout title="Course Programs — Polymath.Sys" activeNav="courses">

<div class="courses-hub">

  <!-- HERO -->
  <div class="ch-hero">
    <div class="ch-hero-label">// 13 PROGRAMS · STRUCTURED MASTERY</div>
    <h1 class="ch-hero-title">Every discipline.<br/>One system.</h1>
    <p class="ch-hero-sub">Each program below is a complete, phased curriculum — not a list of links. Real resources, sequenced correctly, with checkpoints and projects.</p>
  </div>

  <!-- SECTION: CORE COURSES -->
  <div class="ch-section-label">CORE COURSES</div>
  <div class="ch-grid-core">

    <a href="/courses/cs" class="ch-card ch-card-lg">
      <div class="ch-card-accent" style="background:linear-gradient(90deg,#1a3a6b,#0a1628);"></div>
      <div class="ch-card-inner">
        <div class="ch-tag" style="color:#4a82da;border-color:#4a82da44;">CS</div>
        <div class="ch-name">Computer Science</div>
        <div class="ch-meta">12–18 months · OS · Networks · Compilers · Databases · Architecture</div>
        <div class="ch-topics">
          <span>Operating Systems</span><span>Networks</span><span>Compilers</span>
          <span>Databases</span><span>Theory of Computation</span><span>Architecture</span>
        </div>
        <div class="ch-cta">Enter Program &rarr;</div>
      </div>
    </a>

    <a href="/courses/software-engineering" class="ch-card ch-card-lg">
      <div class="ch-card-accent" style="background:linear-gradient(90deg,#1a3a1a,#0a1a0a);"></div>
      <div class="ch-card-inner">
        <div class="ch-tag" style="color:#3c933c;border-color:#3c933c44;">SE</div>
        <div class="ch-name">Software Engineering</div>
        <div class="ch-meta">10–14 months · SDLC · Design Patterns · DevOps · Architecture</div>
        <div class="ch-topics">
          <span>Clean Code</span><span>Design Patterns</span><span>CI/CD</span>
          <span>Architecture</span><span>Testing</span><span>DevOps</span>
        </div>
        <div class="ch-cta">Enter Program &rarr;</div>
      </div>
    </a>

    <a href="/courses/ai-ml-dl" class="ch-card ch-card-lg">
      <div class="ch-card-accent" style="background:linear-gradient(90deg,#2a1a4a,#150a2a);"></div>
      <div class="ch-card-inner">
        <div class="ch-tag" style="color:#8a4baa;border-color:#8a4baa44;">AI · ML · DL</div>
        <div class="ch-name">Artificial Intelligence</div>
        <div class="ch-meta">14–20 months · Classical ML → Deep Learning → LLMs → Agents</div>
        <div class="ch-topics">
          <span>Classical ML</span><span>Deep Learning</span><span>Transformers</span>
          <span>LLMs + RAG</span><span>Diffusion</span><span>Agents</span>
        </div>
        <div class="ch-cta">Enter Program &rarr;</div>
      </div>
    </a>

    <a href="/courses/mathematics" class="ch-card">
      <div class="ch-card-accent" style="background:linear-gradient(90deg,#3a2a0a,#1a1004);"></div>
      <div class="ch-card-inner">
        <div class="ch-tag" style="color:#cb8a3a;border-color:#cb8a3a44;">MATH</div>
        <div class="ch-name">Mathematics</div>
        <div class="ch-meta">Ongoing · Analysis → Algebra → Topology</div>
        <div class="ch-topics">
          <span>Real Analysis</span><span>Abstract Algebra</span><span>Topology</span><span>Number Theory</span>
        </div>
        <div class="ch-cta">Enter Program &rarr;</div>
      </div>
    </a>

    <a href="/courses/quantum-computing" class="ch-card">
      <div class="ch-card-accent" style="background:linear-gradient(90deg,#0a2a2a,#041616);"></div>
      <div class="ch-card-inner">
        <div class="ch-tag" style="color:#3cbcbc;border-color:#3cbcbc44;">QC</div>
        <div class="ch-name">Quantum Computing</div>
        <div class="ch-meta">10–14 months · Qubits → Algorithms → Error Correction</div>
        <div class="ch-topics">
          <span>Qubit Logic</span><span>Quantum Gates</span><span>Qiskit</span><span>QAOA/VQE</span>
        </div>
        <div class="ch-cta">Enter Program &rarr;</div>
      </div>
    </a>

    <a href="/courses/quantum-physics" class="ch-card">
      <div class="ch-card-accent" style="background:linear-gradient(90deg,#1a0a2a,#0d051a);"></div>
      <div class="ch-card-inner">
        <div class="ch-tag" style="color:#aa6bda;border-color:#aa6bda44;">QP</div>
        <div class="ch-name">Quantum Physics</div>
        <div class="ch-meta">12–16 months · QM Formalism → QFT Foundations</div>
        <div class="ch-topics">
          <span>Wave Mechanics</span><span>Hilbert Spaces</span><span>Entanglement</span><span>QFT</span>
        </div>
        <div class="ch-cta">Enter Program &rarr;</div>
      </div>
    </a>

    <a href="/courses/coding" class="ch-card">
      <div class="ch-card-accent" style="background:linear-gradient(90deg,#2a2a0a,#1a1a04);"></div>
      <div class="ch-card-inner">
        <div class="ch-tag" style="color:#ccbb3a;border-color:#ccbb3a44;">CODE</div>
        <div class="ch-name">Coding Mastery</div>
        <div class="ch-meta">6–10 months · C → C++ → Python → Rust → Go</div>
        <div class="ch-topics">
          <span>Systems C/C++</span><span>Python</span><span>Rust</span><span>Assembly</span>
        </div>
        <div class="ch-cta">Enter Program &rarr;</div>
      </div>
    </a>

    <a href="/courses/competitive-programming" class="ch-card">
      <div class="ch-card-accent" style="background:linear-gradient(90deg,#2a0a0a,#1a0404);"></div>
      <div class="ch-card-inner">
        <div class="ch-tag" style="color:#cb4a4a;border-color:#cb4a4a44;">CP</div>
        <div class="ch-name">Competitive Programming</div>
        <div class="ch-meta">8–12 months · CF 800 → 2200+ · IOI/ICPC level</div>
        <div class="ch-topics">
          <span>Greedy</span><span>DP</span><span>Graphs</span><span>Number Theory</span>
        </div>
        <div class="ch-cta">Enter Program &rarr;</div>
      </div>
    </a>

  </div>

  <!-- SECTION: FLAGSHIP PROGRAMS -->
  <div class="ch-section-label">FLAGSHIP PROGRAMS</div>
  <div class="ch-grid-flagship">

    <a href="/courses/engineer" class="ch-flagship">
      <div class="ch-flagship-num">01</div>
      <div class="ch-flagship-body">
        <div class="ch-flagship-tag">WORLD-CLASS ENGINEER</div>
        <div class="ch-flagship-title">The Complete Engineering Mastery Program</div>
        <div class="ch-flagship-desc">The greatest engineer-level curriculum combining CS core with a unified roadmap for DSA, LLD, HLD, System Design, Low-Level &amp; High-Level Programming, Distributed Systems, and AI/ML/DL mastery — all sequenced into a single phased program.</div>
        <div class="ch-flagship-pills">
          <span>CS Core</span><span>DSA</span><span>LLD</span><span>HLD</span>
          <span>System Design</span><span>Distributed Systems</span><span>AI/ML/DL</span><span>Full SE Program</span>
        </div>
        <div class="ch-flagship-cta">Enter Program &rarr;</div>
      </div>
    </a>

    <a href="/courses/polymath" class="ch-flagship">
      <div class="ch-flagship-num">02</div>
      <div class="ch-flagship-body">
        <div class="ch-flagship-tag">POLYMATH MIND PROGRAM</div>
        <div class="ch-flagship-title">Building a Polymath-Level Intellect</div>
        <div class="ch-flagship-desc">The structured system for mastering multiple fields simultaneously. Mathematics, Physics, Engineering, Robotics, CS, Software Engineering and AI — sequenced to compound, not conflict. Modelled on how the greatest polymaths in history actually learned across domains.</div>
        <div class="ch-flagship-pills">
          <span>Mathematics</span><span>Physics</span><span>CS Theory</span><span>Robotics</span>
          <span>Engineering</span><span>AI Integration</span><span>Synthesis</span>
        </div>
        <div class="ch-flagship-cta">Enter Program &rarr;</div>
      </div>
    </a>

  </div>

  <!-- SECTION: CHALLENGES -->
  <div class="ch-section-label">100-DAY CHALLENGES</div>
  <div class="ch-challenges">

    <a href="/challenges" class="ch-challenge-card">
      <div class="ch-challenge-num">100</div>
      <div class="ch-challenge-info">
        <div class="ch-challenge-name">CS / Software Engineering</div>
        <div class="ch-challenge-stat">50 projects · Basic to Expert</div>
      </div>
      <div class="ch-challenge-arrow">&rarr;</div>
    </a>

    <a href="/challenges" class="ch-challenge-card">
      <div class="ch-challenge-num">100</div>
      <div class="ch-challenge-info">
        <div class="ch-challenge-name">AI / ML / DL</div>
        <div class="ch-challenge-stat">50 projects · Data to Production</div>
      </div>
      <div class="ch-challenge-arrow">&rarr;</div>
    </a>

    <a href="/challenges" class="ch-challenge-card">
      <div class="ch-challenge-num">100</div>
      <div class="ch-challenge-info">
        <div class="ch-challenge-name">Polymath Challenge</div>
        <div class="ch-challenge-stat">50 projects · Cross-domain mastery</div>
      </div>
      <div class="ch-challenge-arrow">&rarr;</div>
    </a>

    <a href="/challenges" class="ch-challenge-card">
      <div class="ch-challenge-num">100</div>
      <div class="ch-challenge-info">
        <div class="ch-challenge-name">Competitive Programming</div>
        <div class="ch-challenge-stat">300 problems · Rating 800→2200+</div>
      </div>
      <div class="ch-challenge-arrow">&rarr;</div>
    </a>

    <a href="/challenges" class="ch-challenge-card">
      <div class="ch-challenge-num">100</div>
      <div class="ch-challenge-info">
        <div class="ch-challenge-name">System Design</div>
        <div class="ch-challenge-stat">100 systems designed end-to-end</div>
      </div>
      <div class="ch-challenge-arrow">&rarr;</div>
    </a>

  </div>

  <!-- SECTION: HALL OF LEGENDS -->
  <div class="ch-section-label">HALL OF LEGENDS</div>
  <a href="/polymaths" class="ch-polymaths-banner">
    <div class="ch-pb-left">
      <div class="ch-pb-label">30+ PROFILES · 2,500 YEARS OF GENIUS</div>
      <div class="ch-pb-title">The Greatest Polymaths in History</div>
      <div class="ch-pb-names">
        Aristotle &middot; Da Vinci &middot; Newton &middot; Euler &middot; Gauss &middot; Faraday
        &middot; Von Neumann &middot; Turing &middot; Feynman &middot; Shannon &middot; Tao &middot; Hassabis
      </div>
    </div>
    <div class="ch-pb-right">
      <div class="ch-pb-cta">Explore Hall of Legends &rarr;</div>
    </div>
  </a>

</div>

<style>
.courses-hub {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem 2rem 5rem;
}

/* HERO */
.ch-hero {
  padding: 3rem 0 3.5rem;
  border-bottom: 1px solid #1a1a1a;
  margin-bottom: 3rem;
}
.ch-hero-label {
  font-family: monospace;
  font-size: 11px;
  color: #444;
  letter-spacing: 0.14em;
  margin-bottom: 1.2rem;
}
.ch-hero-title {
  font-size: 3rem;
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: #fff;
  margin-bottom: 1rem;
}
.ch-hero-sub {
  font-size: 14.5px;
  color: #666;
  max-width: 520px;
  line-height: 1.65;
}

/* SECTION LABEL */
.ch-section-label {
  font-family: monospace;
  font-size: 10px;
  color: #3a3a3a;
  letter-spacing: 0.2em;
  padding-bottom: 0.7rem;
  border-bottom: 1px solid #161616;
  margin-bottom: 1.5rem;
  margin-top: 3rem;
}

/* CORE COURSES — asymmetric 3+5 grid */
.ch-grid-core {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: 220px 200px auto;
  gap: 1px;
  background: #161616;
  border: 1px solid #1f1f1f;
  border-radius: 6px;
  overflow: hidden;
}
.ch-card-lg { grid-row: 1; }
/* bottom row: items 4-8 span cols */
.ch-grid-core .ch-card:nth-child(4) { grid-column: 1; grid-row: 2; }
.ch-grid-core .ch-card:nth-child(5) { grid-column: 2; grid-row: 2; }
.ch-grid-core .ch-card:nth-child(6) { grid-column: 3; grid-row: 2; }
.ch-grid-core .ch-card:nth-child(7) { grid-column: 1 / 3; grid-row: 3; }
.ch-grid-core .ch-card:nth-child(8) { grid-column: 3; grid-row: 3; }

.ch-card {
  position: relative;
  background: #080808;
  text-decoration: none;
  display: block;
  overflow: hidden;
  transition: background 0.18s;
}
.ch-card:hover { background: #0f0f0f; }
.ch-card:hover .ch-cta { color: #aaa; }

.ch-card-accent {
  height: 2px;
  width: 100%;
}
.ch-card-inner {
  padding: 1.3rem 1.5rem 1.5rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}
.ch-tag {
  font-family: monospace;
  font-size: 10px;
  letter-spacing: 0.1em;
  border: 1px solid;
  display: inline-block;
  padding: 2px 8px;
  border-radius: 2px;
  width: fit-content;
}
.ch-name {
  font-size: 1.15rem;
  font-weight: 500;
  color: #ddd;
  line-height: 1.2;
  letter-spacing: -0.01em;
}
.ch-card-lg .ch-name { font-size: 1.35rem; }
.ch-meta {
  font-size: 11px;
  color: #484848;
  line-height: 1.5;
}
.ch-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
  margin-top: auto;
  padding-top: 0.6rem;
}
.ch-topics span {
  font-size: 10px;
  background: #111;
  border: 1px solid #1f1f1f;
  color: #555;
  padding: 2px 6px;
  border-radius: 2px;
  font-family: monospace;
}
.ch-cta {
  font-size: 11px;
  color: #383838;
  font-family: monospace;
  letter-spacing: 0.04em;
  margin-top: 0.4rem;
  transition: color 0.18s;
}

/* FLAGSHIP */
.ch-grid-flagship {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: #161616;
  border: 1px solid #1f1f1f;
  border-radius: 6px;
  overflow: hidden;
}
.ch-flagship {
  background: #070707;
  text-decoration: none;
  display: grid;
  grid-template-columns: 70px 1fr;
  transition: background 0.18s;
  min-height: 250px;
}
.ch-flagship:hover { background: #0e0e0e; }
.ch-flagship:hover .ch-flagship-cta { color: #aaa; }
.ch-flagship-num {
  font-family: monospace;
  font-size: 3.5rem;
  font-weight: 700;
  color: #181818;
  padding: 1.5rem 0 0 1rem;
  line-height: 1;
}
.ch-flagship-body {
  padding: 1.5rem 1.8rem 1.8rem 0.3rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.ch-flagship-tag {
  font-family: monospace;
  font-size: 10px;
  letter-spacing: 0.14em;
  color: #444;
}
.ch-flagship-title {
  font-size: 1.05rem;
  font-weight: 500;
  color: #ccc;
  line-height: 1.3;
}
.ch-flagship-desc {
  font-size: 12px;
  color: #585858;
  line-height: 1.65;
}
.ch-flagship-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
  margin-top: 0.4rem;
}
.ch-flagship-pills span {
  font-size: 10px;
  background: #0f0f0f;
  border: 1px solid #1e1e1e;
  color: #4a4a4a;
  padding: 2px 6px;
  border-radius: 2px;
  font-family: monospace;
}
.ch-flagship-cta {
  font-size: 11px;
  color: #383838;
  font-family: monospace;
  margin-top: auto;
  transition: color 0.18s;
}

/* CHALLENGES */
.ch-challenges {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: #161616;
  border: 1px solid #1f1f1f;
  border-radius: 6px;
  overflow: hidden;
}
.ch-challenge-card {
  background: #080808;
  display: grid;
  grid-template-columns: 72px 1fr 32px;
  align-items: center;
  padding: 1rem 1.4rem;
  text-decoration: none;
  transition: background 0.15s;
  border-left: 2px solid transparent;
}
.ch-challenge-card:hover { background: #0e0e0e; border-left-color: #2a2a2a; }
.ch-challenge-card:hover .ch-challenge-arrow { color: #888; }
.ch-challenge-num {
  font-family: monospace;
  font-size: 1.8rem;
  font-weight: 700;
  color: #1c1c1c;
  letter-spacing: -0.04em;
}
.ch-challenge-name {
  font-size: 13px;
  font-weight: 500;
  color: #bbb;
}
.ch-challenge-stat {
  font-size: 11px;
  color: #484848;
  font-family: monospace;
  margin-top: 2px;
}
.ch-challenge-arrow {
  font-size: 14px;
  color: #2a2a2a;
  text-align: right;
  transition: color 0.15s;
}

/* POLYMATHS BANNER */
.ch-polymaths-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #070707;
  border: 1px solid #1f1f1f;
  border-radius: 6px;
  padding: 1.8rem 2rem;
  text-decoration: none;
  transition: all 0.18s;
  gap: 2rem;
  margin-bottom: 2rem;
}
.ch-polymaths-banner:hover { background: #0e0e0e; border-color: #2a2a2a; }
.ch-polymaths-banner:hover .ch-pb-cta { color: #aaa; }
.ch-pb-label {
  font-family: monospace;
  font-size: 10px;
  letter-spacing: 0.14em;
  color: #444;
  margin-bottom: 0.5rem;
}
.ch-pb-title {
  font-size: 1.3rem;
  font-weight: 500;
  color: #ccc;
  letter-spacing: -0.02em;
  margin-bottom: 0.5rem;
}
.ch-pb-names {
  font-size: 11px;
  color: #3a3a3a;
  font-family: monospace;
  line-height: 1.7;
}
.ch-pb-cta {
  font-size: 11px;
  font-family: monospace;
  color: #383838;
  white-space: nowrap;
  transition: color 0.18s;
}

@media (max-width: 820px) {
  .ch-grid-core {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
  }
  .ch-card-lg, .ch-grid-core .ch-card:nth-child(n) {
    grid-column: auto; grid-row: auto;
  }
  .ch-grid-flagship { grid-template-columns: 1fr; }
  .ch-polymaths-banner { flex-direction: column; align-items: flex-start; }
  .ch-hero-title { font-size: 2.2rem; }
}
@media (max-width: 560px) {
  .ch-grid-core { grid-template-columns: 1fr; }
}
</style>

</PhaseLayout>
