    <style>
    .portal-grid { padding: 0 0 2rem; display: flex; flex-direction: column; gap: 0; }

    .pg-zone-label {
      font-family: monospace;
      font-size: 10px;
      color: #333;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      padding: 2.5rem 0 0.75rem;
      border-bottom: 1px solid #141414;
      margin-bottom: 1.5rem;
    }
    .pg-zone-label:first-child { padding-top: 0; }

    /* Full-width row — original horizontal book-card, spine 280px */
    .pg-row-full { margin-bottom: 1.5rem; }
    .pg-row-full .book-card { grid-template-columns: 280px 1fr; }

    /* ── 2-column row: VERTICAL cards (spine = top bar) ── */
    .pg-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }
    /* Force every direct book-card child to vertical layout */
    .pg-row-2 > .book-card {
      display: flex !important;
      flex-direction: column !important;
      grid-template-columns: unset !important;
    }
    .pg-row-2 > .book-card .bc-spine {
      border-right: none !important;
      border-bottom: 1px solid var(--card-border) !important;
      padding: 1.6rem 2rem !important;
      flex-direction: row !important;
      align-items: flex-end !important;
      gap: 1.2rem !important;
      justify-content: flex-start !important;
    }
    .pg-row-2 > .book-card .bc-spine-num { margin-bottom: 0 !important; }
    .pg-row-2 > .book-card .bc-spine-title { font-size: 1.6rem !important; line-height: 1.1 !important; }
    .pg-row-2 > .book-card .bc-pages {
      padding: 1.8rem 2rem !important;
    }
    .pg-row-2 > .book-card .bc-meta { margin-bottom: 1.2rem !important; }
    .pg-row-2 > .book-card .bc-toc { gap: 0.7rem !important; margin-bottom: 1.5rem !important; }
    .pg-row-2 > .book-card .bc-toc li { font-size: 13.5px !important; }

    /* ── 3-column row ── */
    .pg-row-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    /* Vertical card: spine on top as a header bar (used in 3-col) */
    .book-card-v {
      display: flex !important;
      flex-direction: column !important;
    }
    .bc-spine-v {
      border-right: none !important;
      border-bottom: 1px solid var(--card-border) !important;
      padding: 1.4rem 1.8rem !important;
      flex-direction: row !important;
      align-items: flex-end !important;
      gap: 0.8rem !important;
    }
    .bc-spine-v .bc-spine-num { margin-bottom: 0 !important; }
    .bc-spine-v .bc-spine-title { font-size: 1.05rem !important; line-height: 1.15 !important; }
    .book-card-v .bc-pages { padding: 1.6rem 1.8rem !important; }
    .book-card-v .bc-meta { margin-bottom: 1rem !important; }
    .book-card-v .bc-toc { gap: 0.6rem !important; margin-bottom: 1.2rem !important; }
    .book-card-v .bc-toc li { font-size: 13px !important; }

    /* ── 4-column compact row ── */
    .pg-row-4 {
