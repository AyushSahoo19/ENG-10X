    <div class="pm-grid">

      <!-- BENJAMIN FRANKLIN -->
      <div class="polymath-entry">
        <div class="pm-header">
          <div class="pm-initials">BF</div>
          <div class="pm-info">
            <div class="pm-name">Benjamin Franklin</div>
            <div class="pm-years">1706--1790</div>
          </div>
        </div>
        <div class="pm-bio">America's original polymath. Franklin was a printer, writer, inventor, scientist, diplomat, and statesman. He proved lightning was electrical, invented the lightning rod, bifocals, and the Franklin stove, founded the first public library and fire department in America, helped draft the Declaration of Independence, and negotiated the alliance with France that won the Revolutionary War.</div>
        <div class="pm-domains">
          <span class="rtag free">Physics</span>
          <span class="rtag must">Politics</span>
          <span class="rtag vid">Invention</span>
          <span class="rtag book">Writing</span>
