      </div>

      <!-- CLAUDE SHANNON -->
      <div class="polymath-entry">
        <div class="pm-header">
          <div class="pm-initials">CS</div>
          <div class="pm-info">
            <div class="pm-name">Claude Shannon</div>
            <div class="pm-years">1916--2001</div>
